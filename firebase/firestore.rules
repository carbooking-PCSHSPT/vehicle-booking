rules_version = '2';
// ═══════════════════════════════════════════════════════════
// ระบบยานพาหนะ — กฎความปลอดภัย Firestore
// คัดลอกทั้งไฟล์ไปวางที่ Firebase Console → Firestore Database → Rules → Publish
// ต้องตรงกับ app/assets/js/config.js (domains, usernameDomain, bootstrapAdmins)
// ═══════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── ตัวช่วย ─────
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function provider() { return request.auth.token.firebase.sign_in_provider; }
    function googleVerified() { return signedIn() && provider() == 'google.com' && request.auth.token.email_verified == true; }
    function schoolGoogle() { return googleVerified() && email().matches('.*@pcshspt[.]ac[.]th$'); }
    // ผู้ดูแลระบบสูงสุดคนแรก (อีเมลนอกโรงเรียนได้ แต่ต้องเข้าด้วย Google เท่านั้น)
    function bootstrap() { return googleVerified() && email() in ['carbooking.gad@gmail.com']; }
    function userPath(e) { return /databases/$(database)/documents/users/$(e); }
    function hasProfile() { return signedIn() && exists(userPath(email())); }
    function me() { return get(userPath(email())).data; }
    function active() { return hasProfile() && me().active == true; }
    function role(r) { return active() && me().roles.hasAny([r]); }
    function admin() { return role('admin') || role('superadmin'); }
    function sup() { return role('superadmin'); }
    function back() { return admin() || role('executive'); }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function noAdminRoles(roles) { return !roles.hasAny(['admin', 'superadmin']); }

    // ───── ผู้ใช้ ─────
    match /users/{userEmail} {
      allow read: if (signedIn() && userEmail == email()) || admin();
      // ครูเข้าระบบด้วย Google ครั้งแรก → สร้างโปรไฟล์ตัวเอง (สิทธิ์ครูเท่านั้น ยกเว้นผู้ดูแลระบบสูงสุดคนแรก)
      allow create: if (signedIn() && userEmail == email()
                        && request.resource.data.active == true
                        && ((schoolGoogle() && request.resource.data.roles == ['teacher'])
                            || (bootstrap() && request.resource.data.roles.hasAll(['superadmin']))))
                    || (admin() && (sup() || noAdminRoles(request.resource.data.roles)));
      // แก้โปรไฟล์ตัวเองได้ แต่เปลี่ยนสิทธิ์/สถานะ/ผู้ให้บริการไม่ได้
      allow update: if (signedIn() && userEmail == email() && active() && unchanged(['roles', 'active', 'provider', 'email', 'driverId']))
                    || (admin() && (sup() || (noAdminRoles(request.resource.data.roles) && noAdminRoles(resource.data.roles))));
      allow delete: if admin() && (sup() || noAdminRoles(resource.data.roles));
    }

    // ───── ตั้งค่า (หน้าติดต่อเราเปิดให้ทุกคนอ่าน) ─────
    match /config/{doc} {
      allow read: if true;
      allow write: if admin();
    }

    // ───── รถ / คนขับ / สถานที่ ─────
    match /vehicles/{id} { allow read: if active(); allow write: if admin(); }
    match /drivers/{id}  { allow read: if active(); allow write: if admin(); }
    match /places/{id}   { allow read: if active(); allow create, update: if active(); allow delete: if admin(); }
    // ข้อมูลเชิงลึกของรถ (พ.ร.บ. ประกัน ประวัติซ่อม) — ไม่เผยแพร่
    match /vehiclePrivate/{id} { allow read: if back(); allow write: if admin(); }

    // ───── เลขที่คำขอ ─────
    match /counters/{year} { allow read, write: if active(); }

    // ───── คำขอใช้รถ ─────
    match /requests/{id} {
      allow read: if active();
      // ครูส่งคำขอของตัวเอง (สถานะรอตรวจสอบเท่านั้น) · แอดมินบันทึกแทนได้
      allow create: if admin()
                    || (active() && request.resource.data.requester.email == email()
                        && request.resource.data.status == 'pending'
                        && request.resource.data.emergency == false
                        && request.resource.data.assignments.size() == 0
                        && request.resource.data.decision == null);
      allow update: if admin()
                    // ผู้ขอ: แก้ไข/ส่งใหม่/ยกเลิก/ประเมิน — ห้ามแตะผลการพิจารณาและค่าใช้จ่าย
                    || (active() && resource.data.requester.email == email()
                        && unchanged(['requester', 'decision', 'expenses', 'emergency', 'createdBy', 'id'])
                        && (request.resource.data.status == resource.data.status
                            || request.resource.data.status in ['pending', 'cancelled'])
                        && request.resource.data.assignments.size() == resource.data.assignments.size())
                    // คนขับ: กดสถานะ เลขไมล์ ค่าน้ำมัน ของงานที่ตัวเองได้รับมอบหมาย
                    || (role('driver') && email() in resource.data.driverEmails
                        && resource.data.status in ['approved', 'ontrip', 'returned']
                        && request.resource.data.status in ['approved', 'ontrip', 'returned']
                        && unchanged(['requester', 'decision', 'destinations', 'startAt', 'endAt', 'emergency', 'createdBy', 'id', 'driverEmails'])
                        && request.resource.data.assignments.size() == resource.data.assignments.size());
      allow delete: if admin();
    }

    // ───── ผลประเมินคนขับ (ไม่เก็บชื่อผู้ประเมิน) ─────
    match /ratings/{id} {
      allow read: if back();
      allow create: if active() && request.resource.data.keys().hasOnly(['id', 'at', 'driverId', 'vehicleId', 'scores', 'comment']);
      allow update, delete: if admin();
    }
  }
}
