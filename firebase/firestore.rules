rules_version = '2';
// ═══════════════════════════════════════════════════════════
// ระบบยานพาหนะ — กฎความปลอดภัย Firestore
// คัดลอกทั้งไฟล์ไปวางที่ Firebase Console → Firestore Database → Rules → Publish
// ต้องตรงกับ app/assets/js/config.js (domains, usernameDomain, bootstrapAdmins)
// ═══════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ───── ตัวช่วย ─────
    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function provider() { return request.auth.token.firebase.sign_in_provider; }
    function googleVerified() { return signedIn() && provider() == 'google.com' && request.auth.token.email_verified == true; }
    function schoolGoogle() { return googleVerified() && email().matches('.*@pcshspt[.]ac[.]th$'); }
    // ผู้ดูแลระบบสูงสุดคนแรก (อีเมลนอกโรงเรียนได้ แต่ต้องเข้าด้วย Google เท่านั้น)
    function bootstrap() { return googleVerified() && email() in ['carbooking.gad@gmail.com']; }
    function userPath(e) { return /databases/$(database)/documents/users/$(e); }
    function hasProfile() { return signedIn() && exists(userPath(email())); }
    function me() { return get(userPath(email())).data; }
    function active() { return hasProfile() && me().active == true; }
    function role(r) { return active() && me().roles.hasAny([r]); }
    function admin() { return role('admin') || role('superadmin'); }
    function sup() { return role('superadmin'); }
    function back() { return admin() || role('executive'); }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // รายการรถที่มอบหมาย (assignments) — ตรวจทีละคัน ให้แก้ได้เฉพาะฟิลด์ที่กำหนด (รองรับสูงสุด 10 คันต่อคำขอ)
    function asgOnly(i, keys) {
      return i >= resource.data.assignments.size()
        || request.resource.data.assignments[i].diff(resource.data.assignments[i]).affectedKeys().hasOnly(keys);
    }
    function asgAllOnly(keys) {
      return request.resource.data.assignments.size() == resource.data.assignments.size()
        && resource.data.assignments.size() <= 10
        && asgOnly(0, keys) && asgOnly(1, keys) && asgOnly(2, keys) && asgOnly(3, keys) && asgOnly(4, keys)
        && asgOnly(5, keys) && asgOnly(6, keys) && asgOnly(7, keys) && asgOnly(8, keys) && asgOnly(9, keys);
    }
    function noAdminRoles(roles) { return !roles.hasAny(['admin', 'superadmin']); }
    // ผู้ลงนามอิเล็กทรอนิกส์ในบันทึกข้อความ (ตั้งค่า → บันทึกข้อความขอใช้รถ)
    function cfg() { return get(/databases/$(database)/documents/config/settings).data; }
    function memoSigner() { return active() && ('memo' in cfg()) && (email() == cfg().memo.get('headEmail', '') || email() == cfg().memo.get('depEmail', '')); }

    // ───── ผู้ใช้ ─────
    match /users/{userEmail} {
      allow read: if (signedIn() && userEmail == email()) || admin();
      // ครูเข้าระบบด้วย Google ครั้งแรก → สร้างโปรไฟล์ตัวเอง (สิทธิ์ครูเท่านั้น ยกเว้นผู้ดูแลระบบสูงสุดคนแรก)
      allow create: if (signedIn() && userEmail == email()
                        && request.resource.data.active == true
                        && ((schoolGoogle() && request.resource.data.roles == ['teacher'])
                            || (bootstrap() && request.resource.data.roles.hasAll(['superadmin']))))
                    || (admin() && (sup() || noAdminRoles(request.resource.data.roles)));
      // แก้โปรไฟล์ตัวเองได้ แต่เปลี่ยนสิทธิ์/สถานะ/ผู้ให้บริการไม่ได้
      allow update: if (signedIn() && userEmail == email() && active() && unchanged(['roles', 'active', 'provider', 'email', 'driverId']))
                    || (admin() && (sup() || (noAdminRoles(request.resource.data.roles) && noAdminRoles(resource.data.roles))));
      allow delete: if admin() && (sup() || noAdminRoles(resource.data.roles));
    }

    // ───── ตั้งค่า (หน้าติดต่อเราเปิดให้ทุกคนอ่าน) ─────
    match /config/{doc} {
      allow read: if true;
      allow write: if admin();
    }

    // ───── รถ / คนขับ / สถานที่ ─────
    match /vehicles/{id} { allow read: if active(); allow write: if admin(); }
    match /drivers/{id}  { allow read: if active(); allow write: if admin(); }
    match /places/{id}   { allow read: if active(); allow create, update: if active(); allow delete: if admin(); }
    // ข้อมูลเชิงลึกของรถ (พ.ร.บ. ประกัน ประวัติซ่อม) — ไม่เผยแพร่
    match /vehiclePrivate/{id} { allow read: if back(); allow write: if admin(); }

    // ───── เลขที่คำขอ ─────
    match /counters/{year} { allow read, write: if active(); }

    // ───── คำขอใช้รถ ─────
    match /requests/{id} {
      allow read: if active();
      // ครูส่งคำขอของตัวเอง (สถานะรอตรวจสอบเท่านั้น) · แอดมินบันทึกแทนได้
      allow create: if admin()
                    || (active() && request.resource.data.requester.email == email()
                        && request.resource.data.status == 'pending'
                        && request.resource.data.emergency == false
                        && request.resource.data.assignments.size() == 0
                        && request.resource.data.decision == null);
      allow update: if admin()
                    // ผู้ขอ — ห้ามแตะผลการพิจารณา ค่าใช้จ่าย และรถ/คนขับที่แอดมินจัดให้
                    || (active() && resource.data.requester.email == email() && (
                        // 1) แก้ไข / ส่งใหม่ / ยกเลิก ระหว่างรอตรวจสอบหรือถูกส่งกลับให้แก้ไข
                        (resource.data.status in ['pending', 'revise']
                          && request.resource.data.status in ['pending', 'cancelled']
                          && unchanged(['requester', 'decision', 'expenses', 'emergency', 'createdBy', 'createdAt', 'id', 'assignments', 'driverEmails']))
                        // 2) ยกเลิกคำขอที่อนุมัติแล้ว (สถานะ approved = รถยังไม่ออกเดินทาง)
                        || (resource.data.status == 'approved' && request.resource.data.status == 'cancelled'
                          && changedOnly(['status', 'cancel', 'history', 'updatedAt']))
                        // 3) ประเมินคนขับ / ข้ามการประเมิน — แก้ได้เฉพาะเครื่องหมาย rated, ratingSkipped
                        || (request.resource.data.status == resource.data.status
                          && changedOnly(['assignments', 'updatedAt'])
                          && asgAllOnly(['rated', 'ratingSkipped']))
                        // 4) แนบบันทึกข้อความตามหลัง (คำขอที่แอดมินบันทึกแทน) — เพิ่มไฟล์ได้อย่างเดียว ลบไฟล์เดิมไม่ได้
                        || (resource.data.status in ['approved', 'ontrip', 'returned', 'closed']
                          && request.resource.data.status == resource.data.status
                          && changedOnly(['attachments', 'history', 'updatedAt'])
                          && request.resource.data.attachments.size() > resource.data.attachments.size())))
                    // ผู้ลงนาม (หัวหน้างานยานพาหนะ / รองผู้อำนวยการ): เพิ่มการลงนามอิเล็กทรอนิกส์ได้อย่างเดียว
                    || (memoSigner()
                        && resource.data.status in ['approved', 'ontrip', 'returned', 'closed']
                        && request.resource.data.status == resource.data.status
                        && changedOnly(['esign', 'history', 'updatedAt']))
                    // คนขับ: กดออกเดินทาง/กลับถึง เลขไมล์ ค่าน้ำมัน — เปลี่ยนรถ/คนขับ/รายละเอียดคำขอไม่ได้
                    || (role('driver') && email() in resource.data.driverEmails
                        && resource.data.status in ['approved', 'ontrip', 'returned']
                        && request.resource.data.status in ['approved', 'ontrip', 'returned']
                        && changedOnly(['assignments', 'expenses', 'history', 'status', 'updatedAt'])
                        && asgAllOnly(['status', 'departedAt', 'returnedAt', 'odoStart', 'odoEnd']));
      allow delete: if admin();
    }

    // ───── ลายเซ็นอิเล็กทรอนิกส์ (วาดในระบบ) ─────
    // เขียนได้เฉพาะเจ้าของ (คนอื่น/แอดมินปลอมลายเซ็นแทนไม่ได้) · อ่านได้เฉพาะเจ้าของ แอดมิน และผู้บริหาร (ใช้พิมพ์บันทึกข้อความ)
    match /signatures/{userEmail} {
      allow read: if (signedIn() && userEmail == email()) || back();
      allow create, update: if active() && userEmail == email()
                            && request.resource.data.keys().hasOnly(['email', 'img', 'at'])
                            && request.resource.data.email == email()
                            && request.resource.data.img is string
                            && request.resource.data.img.size() < 300000
                            && request.resource.data.img.matches('^data:image/png;base64,.*');
      allow delete: if sup();
    }

    // ───── ผลประเมินคนขับ (ไม่เก็บชื่อผู้ประเมิน) ─────
    match /ratings/{id} {
      allow read: if back();
      allow create: if active() && request.resource.data.keys().hasOnly(['id', 'at', 'driverId', 'vehicleId', 'scores', 'comment']);
      allow update, delete: if admin();
    }
  }
}
